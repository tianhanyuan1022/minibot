# ---- LLM Provider ----
OPENAI_API_KEY=sk-28086720caa744a180f3644b80f7f86a
OPENAI_API_BASE=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-flash
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=4096
MODEL_TIMEOUT_SECONDS=120

# ---- 会话与记忆存储 ----
# 所有持久化文件（sqlite 会话库、memory/*.md、history.jsonl）都放在这个目录下
WORKSPACE_DIR=./workspace

# ---- 上下文压缩（Consolidator） ----
# 模型的上下文窗口大小（估算用，不是精确 tokenizer）
CONTEXT_WINDOW=32000
# 超过 context_window * CONSOLIDATION_RATIO 时触发压缩
CONSOLIDATION_RATIO=0.5

# ---- 长任务（sustained goal） ----
MAX_ITERATIONS=25
MAX_GOAL_CONTINUATIONS=12
RUN_TIMEOUT_SECONDS=600
MAX_CONCURRENT_SUBAGENTS=3
SUBAGENT_TIMEOUT_SECONDS=300
DREAM_AUTO_THRESHOLD=10

# ---- MCP（可选） ----
# 指向一个 JSON 文件，描述要连接的 MCP server，格式见 README。留空则不启用 MCP。
MCP_CONFIG_PATH=./mcp.json